# ==============================================================================
# CONFIGURACIÓN DEL PROYECTO DJANGO + SUPABASE (POSTGRESQL)
# ==============================================================================

# 1. Django Core
DJANGO_SECRET_KEY=django-insecure-agro-proyecto-secreto-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 2. Conexión Directa a PostgreSQL de Supabase (Django ORM)
# Puedes usar DATABASE_URL completa (Project Settings -> Database -> Connection String -> URI)
# Si no se define DATABASE_URL ni DB_HOST, Django usará SQLite local (db.sqlite3) automáticamente para desarrollo.
DATABASE_URL=

# O configurar por variables individuales de Supabase PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.tu-proyecto-id
DB_PASSWORD=tu-password-de-base-de-datos
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543

# 3. Cliente API de Supabase (Opcional / SDK Python)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-o-service-role-key
